<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="14dp" android:paddingBottom="14dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:letterSpacing="0.18" android:textAllCaps="true" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:textSize="19sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
