<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="8dp">
        <TextView android:id="@+id/w_main" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:paddingLeft="11dp" android:paddingRight="11dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
