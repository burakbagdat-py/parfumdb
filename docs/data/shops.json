{
 "v": 4,
 "shops": {
  "boyner": {
   "n": "Boyner",
   "type": "boyner",
   "search": "https://www.boyner.com.tr/search?q={q}"
  },
  "beymen": {
   "n": "Beymen",
   "type": "regex",
   "search": "https://www.beymen.com/tr/search?q={q}",
   "split": "<div class=\"o-productCard[ \"]",
   "url": "href=\"(/tr/p_[^\"]+)\"",
   "title": "title=\"([^\"]+)\"",
   "price": "-salePrice\"[^>]*>\\s*([0-9.,]+)",
   "base": "https://www.beymen.com",
   "fmt": "tr"
  },
  "gratis": {
   "n": "Gratis",
   "type": "regex",
   "search": "https://www.gratis.com/search?q={q}",
   "split": "\\\\\"shareLink\\\\\":",
   "url": "^\\\\\"(https://www\\.gratis\\.com/[^\\\\\"]+)",
   "title": "\\\\\"displayName\\\\\":\\\\\"((?:[^\\\\\"]|\\\\u[0-9a-fA-F]{4})+)",
   "price": "\\\\\"discountedPrice\\\\\":(\\d+)",
   "fmt": "kurus"
  },
  "perfumepoint": {
   "n": "Perfume Point",
   "type": "regex",
   "search": "https://www.perfumepoint.com.tr/arama?q={q}",
   "split": "class=\"col-6 col-sm-6[^\"]*product-item\"",
   "url": "href=\"(/[^\"]+)\" class=\"w-100 product-title",
   "title": "class=\"w-100 product-title text-body\">([^<]+)<",
   "price": "class=\"product-price\">([0-9.,]+)<",
   "base": "https://www.perfumepoint.com.tr",
   "fmt": "tr"
  },
  "n11": {
   "n": "n11",
   "type": "ldjson",
   "search": "https://www.n11.com/arama?q={q}",
   "market": true
  },
  "pazarama": {
   "n": "Pazarama",
   "type": "regex",
   "search": "https://www.pazarama.com/arama?q={q}",
   "split": "data-testid=\"listing-product-card-grid\"",
   "url": "<a href=\"(/[^\"]+-p-\\d+)\"",
   "title": "title=\"([^\"]+)\"",
   "price": "price-sale-price\"[^>]*>\\s*([0-9.,]+)",
   "base": "https://www.pazarama.com",
   "fmt": "tr",
   "market": true
  }
 }
}
